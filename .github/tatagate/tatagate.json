{
  "schema": 1,
  "repository": "citizenwallet",
  "workflows": [
    "release-ios.yml",
    "release-android.yml"
  ],
  "node_tests": [
    "scripts/build.mjs",
    "scripts/publish.mjs",
    "icons/generate.mjs",
    ".github/workflows/release-ios.mjs",
    ".github/workflows/release-android.mjs"
  ],
  "checks": [
    "repository-contracts",
    "cross-platform-contracts",
    "flow-isolation",
    "syntax"
  ],
  "platform_forbidden_values": [
    "macOS ARM64",
    "macos-arm64",
    "macos_arm64"
  ],
  "github_repository": "crcfrcn/citizenwallet",
  "functions": [
    {
      "function": "rust/source/sr25519",
      "path": "rust/source/sr25519.rs",
      "runner": "cargo",
      "target": "rust/Cargo.toml",
      "package": "citizenwallet_signer",
      "cases": [
        "hard_derive_is_deterministic",
        "sign_then_verify_roundtrip",
        "null_arguments_are_rejected"
      ]
    },
    {
      "function": "scripts/build",
      "path": "scripts/build.mjs",
      "runner": "node",
      "target": "node"
    },
    {
      "function": "test/login_qr_handler_test",
      "path": "test/signing/login_qr_handler_test.dart",
      "runner": "flutter",
      "target": "flutter"
    },
    {
