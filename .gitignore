app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Android 正式签名材料禁止写入项目；以下格式只作为误放私钥的最后一道提交保护。
*.jks
*.keystore

/target
.claude/

target/
*.sst

# Python cache
**/__pycache__/

# Local/generated backup files
*.spec*-backup

# OS / Editor junk
**/.DS_Store
*.tmp

# IDE local settings
.vscode/

# JS/TS local artifacts
**/node_modules/
**/*.tsbuildinfo

# Dart / Flutter generated files
**/.dart_tool/
**/.packages
**/.flutter-plugins
**/.flutter-plugins-dependencies
**/.pub/
**/build/
**/coverage/

# Flutter iOS generated dependencies
**/ios/Pods/
**/ios/.symlinks/
**/ios/Flutter/ephemeral/
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/flutter_export_environment.sh
**/ios/Flutter/Flutter.podspec

# Flutter Android local/generated files
**/android/.gradle/
**/android/local.properties

# Android 系统错误报告可能包含设备与网络诊断信息，禁止进入仓库。
/bugreport-*.zip

# Flutter IDE user state
**/ios/Runner.xcworkspace/xcuserdata/
**/ios/Runner.xcodeproj/xcuserdata/

# CitizenWallet 原生编译临时状态
**/android/.kotlin/

# 本机 AI 入口直接解析唯一规则；产品源码不跟踪本机链接。
/CODEX.md
/CLAUDE.md
/target/

